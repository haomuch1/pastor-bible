# Dependencies
node_modules/

# Build output
dist/
src-tauri/target/

# The full index, with every candidate model's vectors. The pipeline writes it,
# pipeline/strip_index.py cuts it down to the one model the app searches with,
# and only the cut-down copy is shipped. Neither is ever committed.
data/index-full.db

# The assembled sidecar: one llama-server and the libraries it loads, including
# the Vulkan backend. Placed by tools/fetch_llama.py --bundle, fetched by tag
# and checksum, bundled by the installer, never committed.
src-tauri/resources/llama/

# Built index: generated by the pipeline, shipped as a release asset, never committed.
# The journal and WAL sidecars are transient and must never be committed either.
src-tauri/resources/index.db
src-tauri/resources/index.db-journal
src-tauri/resources/index.db-wal
src-tauri/resources/index.db-shm

# Model files: never committed. The chat model is downloaded on first run into
# the application data directory; the embedding model is a bundled resource,
# placed in src-tauri/resources/ by tools/fetch_model.py.
*.gguf

# Environment
.env

# OS junk
Thumbs.db
.DS_Store

# Vite / Node logs
logs
*.log
npm-debug.log*
dist-ssr
*.local

# Editor
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.sw?

# Python pipeline (build-time only, never shipped). A virtual environment is
# ignored wherever it is put: the pipeline's own, and any a contributor makes at
# the root, which is where most people make one.
pipeline/.venv/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# The llama.cpp sidecar, placed by tools/fetch_llama.py --sidecar. Fetched by
# tag and checksum, bundled by the installer, never committed.
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep

# Build-time tools and model files: never committed, never shipped in this form.
# The fetcher itself is source and must be in the repository: it is what pins
# the llama.cpp release and refuses to unpack an archive whose checksum is wrong.
tools/*
!tools/fetch_llama.py
!tools/fetch_model.py
!tools/shot.ps1
!tools/click.ps1
models/

# Evaluation scratch output; the kept copy lives in data/eval/
/eval_results.json
data/eval/runs/*/raw/
