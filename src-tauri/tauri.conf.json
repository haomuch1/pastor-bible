{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Pastor Bible",
  "identifier": "io.github.haomuch1.pastorbible",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "The Pastor Bible",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/index.db",
      "resources/nomic-embed-text-v1.5-f16.gguf",
      "resources/llama/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "nsis-installer.nsi",
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "./installer.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.3",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "category": "Education",
    "shortDescription": "Search the Bible and read what it says, with citations.",
    "longDescription": "The Pastor Bible searches the whole text of the World English Bible, shows every passage it found, and writes a short synopsis of what those passages say. It cites only passages that were actually retrieved. Everything runs on your own computer.",
    "licenseFile": "../LICENSE",
    "publisher": "Jared"
  }
}
